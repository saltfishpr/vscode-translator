{
  "name": "vscode-llm-translator",
  "displayName": "Translator for VS Code",
  "description": "Translate selected text and hover documentation using multiple LLM providers, Google, DeepL, and Baidu",
  "version": "0.1.5",
  "publisher": "saltfishpr",
  "repository": {
    "type": "git",
    "url": "https://github.com/saltfishpr/vscode-translator"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "translator.translateSelection",
        "title": "Translate: Translate Selected Text"
      },
      {
        "command": "translator.translateAndReplace",
        "title": "Translate: Translate and Replace Selection"
      },
      {
        "command": "translator.pickProvider",
        "title": "Translate: Switch Provider"
      },
      {
        "command": "translator.pickTargetLang",
        "title": "Translate: Switch Target Language"
      }
    ],
    "keybindings": [
      {
        "command": "translator.translateSelection",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorHasSelection"
      },
      {
        "command": "translator.translateAndReplace",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Translator",
      "properties": {
        "translator.provider": {
          "order": 1,
          "type": "string",
          "enum": [
            "openai",
            "deepseek",
            "zai",
            "openai-compatible",
            "google",
            "deepl",
            "baidu"
          ],
          "default": "google",
          "description": "Translation provider"
        },
        "translator.targetLang": {
          "order": 2,
          "type": "string",
          "default": "zh-CN",
          "description": "Target language code (e.g. zh-CN, en, ja, fr)"
        },
        "translator.sourceLang": {
          "order": 3,
          "type": "string",
          "default": "auto",
          "description": "Source language code; 'auto' for auto-detect"
        },
        "translator.apiKey": {
          "order": 4,
          "type": "string",
          "default": "",
          "description": "API key for the selected LLM provider (OpenAI, DeepSeek, Z.AI, or an OpenAI-compatible endpoint)"
        },
        "translator.model": {
          "order": 5,
          "type": "string",
          "default": "gpt-5.4-mini",
          "description": "Model ID for the selected LLM provider. Built-in providers require a model in the pi-ai catalog; openai-compatible accepts custom model or deployment IDs."
        },
        "translator.thinkingLevel": {
          "order": 6,
          "type": "string",
          "enum": [
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "off",
          "description": "LLM reasoning level. Built-in providers validate against the pi-ai catalog; custom endpoints validate model-specific support on the server."
        },
        "translator.baseUrl": {
          "order": 7,
          "type": "string",
          "default": "",
          "description": "Base URL used only when provider is openai-compatible (e.g. https://ark.cn-beijing.volces.com/api/v3). Built-in providers use pi-ai endpoints."
        },
        "translator.google.apiKey": {
          "order": 8,
          "type": "string",
          "default": "",
          "description": "Google Cloud Translation API key (leave empty to use free endpoint)"
        },
        "translator.deepl.apiKey": {
          "order": 9,
          "type": "string",
          "default": "",
          "description": "DeepL API key"
        },
        "translator.deepl.useFree": {
          "order": 10,
          "type": "boolean",
          "default": true,
          "description": "Use DeepL free API endpoint"
        },
        "translator.baidu.appid": {
          "order": 11,
          "type": "string",
          "default": "",
          "description": "Baidu Translate APP ID"
        },
        "translator.baidu.secret": {
          "order": 12,
          "type": "string",
          "default": "",
          "description": "Baidu Translate secret"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test out/test/*.unit.js && vscode-test",
    "test:unit": "npm run compile-tests && node --test out/test/*.unit.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@vscode/tree-sitter-wasm": "^0.3.1"
  }
}
